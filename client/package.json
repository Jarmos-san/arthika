{
  "name": "arthika-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "openapi:generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate --silent",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "nuxt": "^4.4.8",
    "reka-ui": "^2.10.1",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.40",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@kubb/core": "5.0.0-beta.79",
    "@kubb/plugin-ts": "5.0.0-beta.80",
    "kubb": "5.0.0-beta.79",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@11.13.0"
}
