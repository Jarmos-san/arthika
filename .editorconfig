root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{json,yml}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,js,mjs}]
indent_style = space
indent_size = 2

[*.vue]
indent_style = space
indent_size = 2

[*.css]
indent_style = space
indent_size = 2
